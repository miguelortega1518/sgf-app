# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/sgf

# JWT Secret - generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-here

# Webhook de GitHub (POST /api/integrations/github/webhook). Mismo valor que el "Secret" del webhook del repo.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si está vacío, el webhook responde 401 a todas las entregas.
GITHUB_WEBHOOK_SECRET=

# Resumen diario por correo (POST /api/cron/daily-digest). Lo llama un workflow programado de GitHub Actions
# con "Authorization: Bearer <CRON_SECRET>"; el mismo valor va en los secretos del repo (docs/OPERACIONES.md §12).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si está vacío, el endpoint responde 401 a todas las llamadas.
CRON_SECRET=

# Aprobación de tareas AI Factory: token solo del servidor (nunca NEXT_PUBLIC).
# Fine-grained PAT: Contents write; Pull requests, Checks y Commit statuses read.
FORJA_GITHUB_TOKEN=
# Repositorios permitidos, rama destino y nombres exactos de checks obligatorios.
# Ajustar los nombres a los jobs reales de CI antes de habilitar.
FORJA_GITHUB_APPROVAL_REPOS={"miguelortega1518/sgf-app":{"base":"master","checks":["verify"]}}

# Email (Resend)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=sgf@grupoblb.do

# Entorno
NODE_ENV=development

# URL base de la app
NEXT_PUBLIC_APP_URL=http://localhost:3000
