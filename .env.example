# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/sgf

# JWT Secret - generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-here

# Webhook de GitHub (POST /api/integrations/github/webhook). Mismo valor que el "Secret" del webhook del repo.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si está vacío, el webhook responde 401 a todas las entregas.
GITHUB_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=sgf@grupoblb.do

# Entorno
NODE_ENV=development

# URL base de la app
NEXT_PUBLIC_APP_URL=http://localhost:3000
